# ==============================================================================
# SISTLABUM: Environment Variables Example
# PERINGATAN: Jangan pernah menaruh kredensial asli di repository!
# ==============================================================================

# Runtime
NODE_ENV=development
PORT=3000

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistlabum?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_ACCESS_SECRET="change-this-to-a-very-long-and-secure-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-very-long-and-secure-random-string-min-32-chars"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Data Encryption at-Rest (AES-256-GCM - 32 bytes hex)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Object Storage (S3 / MinIO / Cloudflare R2)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="sistlabum-files"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000/sistlabum-files"

# Notification Providers
FCM_SERVICE_ACCOUNT_PATH="./config/firebase-service-account.json"
WA_PROVIDER="fonnte"
WA_API_KEY="dummy-wa-api-key"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@sekolah.sch.id"

# URLs & CORS
APP_PUBLIC_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Sentry
SENTRY_DSN=""
