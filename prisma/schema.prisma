  schoolId   String?                @map("school_id") @db.Uuid
  authorId   String                 @map("author_id") @db.Uuid
  title      String                 @db.VarChar(255)
  body       String                 @db.Text
  targetType AnnouncementTargetType @default(semua) @map("target_type")
  targetIds  Json?                  @map("target_ids") // Array ID kelas/role jika spesifik
  publishAt  DateTime               @default(now()) @map("publish_at") @db.Timestamptz(6)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  author User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reads  AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

model NotificationTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  code         String   @unique @db.VarChar(100) // RAPOR_TERBIT, IZIN_DISETUJUI
  channel      String   @db.VarChar(30) // push, wa, email
  templateText String   @map("template_text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  logs NotificationLog[]

  @@map("notification_templates")
}

model NotificationLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  channel     String   @db.VarChar(30)
  status      String   @db.VarChar(50) // sent, failed, queued
  providerRef String?  @map("provider_ref") @db.VarChar(255)
  error       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([channel, status])
  @@map("notification_logs")
}

model File {
  id         String         @id @default(uuid()) @db.Uuid
  schoolId   String?        @map("school_id") @db.Uuid
  ownerId    String?        @map("owner_id") @db.Uuid
  ownerType  String?        @map("owner_type") @db.VarChar(50)
  bucket     String         @db.VarChar(100)
  objectKey  String         @unique @map("object_key") @db.VarChar(500)
  mimeType   String         @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt         @map("size_bytes")
  visibility FileVisibility @default(privat)
  checksum   String?        @db.VarChar(100)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Reverse Relations
  studentPhotos         Student[]              @relation("StudentPhotoFile")
  teacherPhotos         Teacher[]              @relation("TeacherPhotoFile")
  applicantDocuments    ApplicantDocument[]    @relation("ApplicantDocumentFile")
  leaveAttachments      LeaveRequest[]         @relation("LeaveRequestAttachmentFile")
  teachingMaterials     TeachingMaterial[]     @relation("TeachingMaterialFile")
  learningMaterials     LearningMaterial[]     @relation("LearningMaterialFile")
  assignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmissionFile")
  progressReports       ProgressReport[]       @relation("ProgressReportFile")
  reportCards           ReportCard[]           @relation("ReportCardFile")
  studentPoints         StudentPoint[]         @relation("StudentPointEvidenceFile")
  activityDocuments     ActivityDocument[]     @relation("ActivityDocFile")
  tripGuides            Trip[]                 @relation("TripGuideFile")
  ticketPhotos          Ticket[]               @relation("TicketPhotoFile")
  ticketEvents          TicketEvent[]          @relation("TicketEventFile")
  digitalBooks          LibraryBook[]          @relation("LibraryBookDigitalFile")
  guestPhotos           Guest[]                @relation("GuestPhotoFile")
  mouDocuments          Partnership[]          @relation("PartnershipMouFile")
  postCovers            Post[]                 @relation("PostCoverFile")
  albumCovers           Album[]                @relation("AlbumCoverFile")
  mediaItems            MediaItem[]            @relation("MediaItemFile")
  bulletinPdfs          Bulletin[]             @relation("BulletinPdfFile")
  bulletinCovers        Bulletin[]             @relation("BulletinCoverFile")
  downloads             Download[]             @relation("DownloadCenterFile")
  jobResults            Job[]                  @relation("JobResultFile")

  @@index([schoolId])
  @@index([ownerType, ownerId])
  @@map("files")
}

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String?   @map("school_id") @db.Uuid
  requestedBy  String?   @map("requested_by") @db.Uuid
  resultFileId String?   @map("result_file_id") @db.Uuid
  jobType      String    @map("job_type") @db.VarChar(100) // GENERATE_RAPOR_MASSAL, EXPORT_EXCEL
  status       JobStatus @default(pending)
  progress     Int       @default(0) // 0 - 100
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester  User? @relation("JobRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  resultFile File? @relation("JobResultFile", fields: [resultFileId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@map("jobs")
}

model AppConfig {
  configKey   String   @id @map("config_key") @db.VarChar(100)
  configValue Json     @map("config_value")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_config")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  holidayDate DateTime @map("holiday_date") @db.Date
  name        String   @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, holidayDate])
  @@map("holidays")
}
