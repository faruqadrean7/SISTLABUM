// ==============================================================================
// SISTLABUM: Portal Sekolah Satu Pintu
// Database Schema Specification (PostgreSQL 16 + Prisma ORM)
// Sesuai dengan: 08_DATABASE_SCHEMA.md & 12_ERD.md
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserStatus {
  active
  suspended
  locked
}

enum Gender {
  L
  P
}

enum StudentStatus {
  aktif
  lulus
  pindah
  keluar
}

enum WaveStatus {
  draft
  aktif
  ditutup
  selesai
}

enum ApplicantStatus {
  draft
  submitted
  verified
  revision
  selected
  waitlist
  rejected
  enrolled
}

enum VerificationStatus {
  menunggu
  valid
  ditolak
}

enum AttendanceStatus {
  hadir
  izin
  sakit
  alpa
  terlambat
}

enum AttendanceSource {
  kelas
  gerbang
}

enum LeaveType {
  sakit
  izin
  dispen
}

enum RequestDecisionStatus {
  menunggu
  disetujui
  ditolak
}

enum StaffAttendanceStatus {
  hadir
  terlambat
  izin
  sakit
  alpa
}

enum PeriodStatus {
  open
  locked
}

enum GradeSource {
  manual
  cbt
}

enum ProgressReportStatus {
  draft
  menunggu_acc
  disetujui
  terbit
}

enum ReportCardStatus {
  draft
  terkunci
  disahkan
  terbit
}

enum QuestionType {
  pg
  pg_kompleks
  bs
  menjodohkan
  isian
  uraian
}

enum CognitiveLevel {
  LOTS
  MOTS
  HOTS
}

enum ContentStatus {
  draft
  aktif
  arsip
}

enum ExamType {
  kuis
  harian
  STS
  SAS
  remedial
  pengayaan
}

enum ExamStatus {
  draft
  dijadwalkan
  berlangsung
  selesai
  arsip
}

enum ExamSessionStatus {
  belum
  mengerjakan
  selesai
  terkunci
}

enum PointKind {
  pelanggaran
  prestasi
}

enum SeverityLevel {
  rendah
  sedang
  tinggi
  berat
}

enum MemberStatus {
  aktif
  nonaktif
  keluar
}

enum ActivityDocType {
  proposal
  laporan
}

enum FacilityType {
  ruang
  alat
}

enum BookingStatus {
  diajukan
  disetujui
  ditolak
  selesai
}

enum AssetCondition {
  baik
  rusak_ringan
  rusak_berat
}

enum TicketPriority {
  rendah
  sedang
  tinggi
  darurat
}

enum TicketStatus {
  pending
  diproses
  selesai
}

enum BookType {
  fisik
  digital
}

enum ContentVisibility {
  publik
  internal
}

enum PostStatus {
  draft
  terbit
  arsip
}

enum AnnouncementTargetType {
  semua
  kelas
  tingkat
  role
}

enum FileVisibility {
  publik
  privat
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

// ==============================================================================
// 1. IDENTITAS, ROLE, SESI & AUDIT
// ==============================================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  schoolId           String?    @map("school_id") @db.Uuid
  username           String     @unique @db.VarChar(100)
  email              String?    @unique @db.VarChar(255)
  phone              String?    @db.VarChar(30)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Profil
  student  Student?
  teacher  Teacher?
  guardian Guardian?
  staff    Staff?

  // Relasi Keamanan & Sesi
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  devices        Device[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]

  // Relasi Bisnis Lintas Domain
  staffAttendances       StaffAttendance[]
  createdExams           Exam[]                 @relation("ExamCreatedBy")
  gradedAnswers          ExamAnswer[]           @relation("ExamAnswerGradedBy")
  proctorActions         ExamProctorAction[]    @relation("ProctorActionActor")
  recordedPoints         StudentPoint[]         @relation("PointRecordedBy")
  counselorCases         CounselingCase[]       @relation("CounselorInCase")
  referredCounselings    CounselingReferral[]   @relation("CounselingReferredBy")
  counselingRequests     CounselingRequest[]    @relation("CounselingRequestedBy")
  handledEarlyWarnings   EarlyWarning[]         @relation("EarlyWarningHandledBy")
  bookingRequests        Booking[]              @relation("BookingRequestedBy")
  decidedBookings        Booking[]              @relation("BookingDecidedBy")
  reportedTickets        Ticket[]               @relation("TicketReporter")
  assignedTickets        Ticket[]               @relation("TicketAssignee")
  ticketEvents           TicketEvent[]          @relation("TicketEventActor")
  bookLoans              Loan[]                 @relation("LoanBorrower")
  labEquipmentLoans      LabLoan[]              @relation("LabLoanBorrower")
  targetedGuests         Guest[]                @relation("GuestTargetUser")
  reportedComplaints     Complaint[]            @relation("ComplaintReporter")
  assignedComplaints     Complaint[]            @relation("ComplaintAssignee")
  complaintEvents        ComplaintEvent[]       @relation("ComplaintEventActor")
  authoredPosts          Post[]                 @relation("PostAuthor")
  authoredAnnouncements  Announcement[]         @relation("AnnouncementAuthor")
  announcementReads      AnnouncementRead[]
  notifications          Notification[]
  notificationLogs       NotificationLog[]
  requestedJobs          Job[]                  @relation("JobRequestedBy")
  recordedAttendances    Attendance[]           @relation("AttendanceRecordedBy")
  decidedLeaveRequests   LeaveRequest[]         @relation("LeaveRequestDecidedBy")
  enteredGrades          Grade[]                @relation("GradeEnteredBy")
  lockedGradePeriods     GradePeriod[]          @relation("GradePeriodLockedBy")
  approvedProgressReports ProgressReport[]      @relation("ProgressReportApprovedBy")
  approvedReportCards    ReportCard[]           @relation("ReportCardApprovedBy")
  uploadedMaterials      TeachingMaterial[]     @relation("TeachingMaterialUploadedBy")
  verifiedPPDBDocuments  ApplicantDocument[]    @relation("PPDBDocVerifiedBy")
  applicantStatusLogs    ApplicantStatusHistory[] @relation("ApplicantStatusActor")
  examRoomProctorings    ExamRoom[]             @relation("ExamRoomProctor")

  @@index([schoolId])
  @@index([username])
  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100) // modul.resource.aksi
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  scopeClassId String?  @map("scope_class_id") @db.Uuid // Opsional pembatas data (misal: Wali Kelas)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeClass Class? @relation(fields: [scopeClassId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([scopeClassId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String?   @map("device_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  platform   String    @db.VarChar(30) // android | ios | web
  fcmToken   String?   @map("fcm_token") @db.VarChar(500)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([entity, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ==============================================================================
// 2. MASTER DATA (AKADEMIK, SISWA, GURU, WALI)
// ==============================================================================

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String?   @map("school_id") @db.Uuid
  name      String    @unique @db.VarChar(50) // e.g. 2026/2027
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  semesters Semesters[]
  classes   Class[]

  @@map("academic_years")
}

model Semesters {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String    @db.VarChar(50) // Ganjil / Genap
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  isActive       Boolean   @default(false) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  schedules           Schedule[]
  gradeComponents     GradeComponent[]
  gradePeriods        GradePeriod[]
  reportCards         ReportCard[]

  @@unique([academicYearId, name])
  @@map("semesters")
}

model GradeLevel {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  name      String   @db.VarChar(50) // Kelas 10, 11, 12 atau 7, 8, 9
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classes           Class[]
  teachingMaterials TeachingMaterial[]
  questionBanks     QuestionBank[]

  @@map("grade_levels")
}

model Major {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  name      String   @db.VarChar(100) // IPA / IPS / TKJ / RPL
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classes Class[]

  @@map("majors")
}

model Class {
  id                 String    @id @default(uuid()) @db.Uuid
  schoolId           String?   @map("school_id") @db.Uuid
  academicYearId     String    @map("academic_year_id") @db.Uuid
  gradeLevelId       String    @map("grade_level_id") @db.Uuid
  majorId            String?   @map("major_id") @db.Uuid
  homeroomTeacherId  String?   @map("homeroom_teacher_id") @db.Uuid
  name               String    @db.VarChar(100) // e.g. X-MIPA-1
  capacity           Int       @default(36)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  academicYear    AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel      GradeLevel           @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  major           Major?               @relation(fields: [majorId], references: [id], onDelete: SetNull)
  homeroomTeacher Teacher?             @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  classStudents       ClassStudent[]
  teachingAssignments TeachingAssignment[]
  schedules           Schedule[]
  gradeComponents     GradeComponent[]
  learningMaterials   LearningMaterial[]
  assignments         Assignment[]
  scopedUserRoles     UserRole[]

  @@unique([academicYearId, name])
  @@index([homeroomTeacherId])
  @@map("classes")
}

model ClassStudent {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Date
  leftAt    DateTime? @map("left_at") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_students")
}

model Student {
  id           String        @id @default(uuid()) @db.Uuid
  schoolId     String?       @map("school_id") @db.Uuid
  userId       String?       @unique @map("user_id") @db.Uuid
  nis          String        @unique @db.VarChar(30)
  nisn         String        @unique @db.VarChar(30)
  nikEnc       String        @map("nik_enc") @db.VarChar(255) // Enkripsi at-rest aplikasi
  fullName     String        @map("full_name") @db.VarChar(200)
  gender       Gender
  birthPlace   String        @map("birth_place") @db.VarChar(100)
  birthDate    DateTime      @map("birth_date") @db.Date
  religion     String?       @db.VarChar(50)
  address      String?       @db.Text
  photoFileId  String?       @map("photo_file_id") @db.Uuid
  status       StudentStatus @default(aktif)
  entryDate    DateTime      @default(now()) @map("entry_date") @db.Date
  graduatedAt  DateTime?     @map("graduated_at") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoFile File? @relation("StudentPhotoFile", fields: [photoFileId], references: [id], onDelete: SetNull)

  // Relasi Data
  statusHistory          StudentStatusHistory[]
  studentGuardians       StudentGuardian[]
  classStudents          ClassStudent[]
  attendances            Attendance[]
  leaveRequests          LeaveRequest[]
  grades                 Grade[]
  characterNotes         CharacterNote[]
  progressReports        ProgressReport[]
  reportCards            ReportCard[]
  examParticipants       ExamParticipant[]
  examSessions           ExamSession[]
  studentPoints          StudentPoint[]
  extracurricularMembers ExtracurricularMember[]
  competitionEntries     CompetitionEntry[]
  achievements           Achievement[]
  tripParticipants       TripParticipant[]
  counselingCases        CounselingCase[]
  counselingReferrals    CounselingReferral[]
  counselingRequests     CounselingRequest[]
  earlyWarnings          EarlyWarning[]
  assignmentSubmissions  AssignmentSubmission[]
  exchangeParticipants   ExchangeParticipant[]
  alumniRecord           Alumni?
  applicantOrigin        Applicant?             @relation("ApplicantConvertedStudent")

  @@index([schoolId])
  @@index([fullName])
  @@index([status])
  @@map("students")
}

model StudentStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  status        String   @db.VarChar(50)
  reason        String?  @db.Text
  effectiveDate DateTime @default(now()) @map("effective_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_status_history")
}

model Guardian {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String?   @map("school_id") @db.Uuid
  userId     String?   @unique @map("user_id") @db.Uuid
  fullName   String    @map("full_name") @db.VarChar(200)
  phone      String    @db.VarChar(30)
  occupation String?   @db.VarChar(100)
  address    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentGuardians StudentGuardian[]
  tripConsents     TripConsent[]

  @@index([schoolId])
  @@index([fullName])
  @@map("guardians")
}

model StudentGuardian {
  studentId    String   @map("student_id") @db.Uuid
  guardianId   String   @map("guardian_id") @db.Uuid
  relationship String   @db.VarChar(50) // ayah | ibu | wali
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Teacher {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String?   @map("school_id") @db.Uuid
  userId      String?   @unique @map("user_id") @db.Uuid
  nip         String?   @unique @db.VarChar(50)
  nuptk       String?   @unique @db.VarChar(50)
  fullName    String    @map("full_name") @db.VarChar(200)
  position    String?   @db.VarChar(100)
  status      String    @default("tetap") @db.VarChar(50)
  photoFileId String?   @map("photo_file_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoFile File? @relation("TeacherPhotoFile", fields: [photoFileId], references: [id], onDelete: SetNull)

  homeroomClasses     Class[]              @relation("ClassHomeroomTeacher")
  teachingAssignments TeachingAssignment[]
  schedules           Schedule[]
  journals            Journal[]
  coachedEkskuls      Extracurricular[]    @relation("CoachExtracurricular")
  learningMaterials   LearningMaterial[]
  assignments         Assignment[]

  @@index([schoolId])
  @@index([fullName])
  @@map("teachers")
}

model Staff {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String?   @map("school_id") @db.Uuid
  userId    String?   @unique @map("user_id") @db.Uuid
  fullName  String    @map("full_name") @db.VarChar(200)
  position  String?   @db.VarChar(100)
  unit      String?   @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@map("staff")
}

model Subject {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String?   @map("school_id") @db.Uuid
  code         String    @unique @db.VarChar(30)
  name         String    @db.VarChar(150)
  subjectGroup String    @map("subject_group") @db.VarChar(50) // Umum, Kejuruan, Pilihan, Muatan Lokal
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  teachingAssignments TeachingAssignment[]
  schedules           Schedule[]
  gradeComponents     GradeComponent[]
  descriptionTemplates ReportDescriptionTemplate[]
  questionBanks       QuestionBank[]
  exams               Exam[]
  teachingMaterials   TeachingMaterial[]
  learningMaterials   LearningMaterial[]
  assignments         Assignment[]

  @@map("subjects")
}

model TeachingAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  semesterId   String   @map("semester_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  hoursPerWeek Int      @default(2) @map("hours_per_week")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  semester Semesters @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  class    Class     @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([semesterId, classId, subjectId])
  @@index([teacherId])
  @@map("teaching_assignments")
}

model Room {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String?   @map("school_id") @db.Uuid
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(150)
  roomType  String    @map("room_type") @db.VarChar(50) // kelas | lab | aula | perpus
  capacity  Int       @default(40)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  schedules    Schedule[]
  examRooms    ExamRoom[]
  facilities   Facility[]
  assets       Asset[]
  tickets      Ticket[]
  labEquipment LabEquipment[]

  @@map("rooms")
}

// ==============================================================================
// 3. PPDB (PENERIMAAN PESERTA DIDIK BARU)
// ==============================================================================

model PPDBWave {
  id               String     @id @default(uuid()) @db.Uuid
  schoolId         String?    @map("school_id") @db.Uuid
  name             String     @db.VarChar(150) // Gelombang 1 / Jalur Prestasi
  openAt           DateTime   @map("open_at") @db.Timestamptz(6)
  closeAt          DateTime   @map("close_at") @db.Timestamptz(6)
  resultPublishAt  DateTime   @map("result_publish_at") @db.Timestamptz(6)
  status           WaveStatus @default(draft)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tracks     PPDBTrack[]
  applicants Applicant[]

  @@map("ppdb_waves")
}

model PPDBTrack {
  id           String   @id @default(uuid()) @db.Uuid
  waveId       String   @map("wave_id") @db.Uuid
  code         String   @db.VarChar(50) // zonasi, prestasi, afirmasi
  name         String   @db.VarChar(100)
  quota        Int
  scoreFormula Json?    @map("score_formula") // Formula ranking terkonfigurasi
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  wave         PPDBWave          @relation(fields: [waveId], references: [id], onDelete: Cascade)
  requirements PPDBRequirement[]
  applicants   Applicant[]

  @@unique([waveId, code])
  @@map("ppdb_tracks")
}

model PPDBRequirement {
  id           String   @id @default(uuid()) @db.Uuid
  trackId      String   @map("track_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(100) // KK, Akta, Rapor, Sertifikat
  isRequired   Boolean  @default(true) @map("is_required")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  track PPDBTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("ppdb_requirements")
}

model Applicant {
  id             String          @id @default(uuid()) @db.Uuid
  waveId         String          @map("wave_id") @db.Uuid
  trackId        String          @map("track_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  studentId      String?         @unique @map("student_id") @db.Uuid // Mengunci idempoten konversi
  registrationNo String          @unique @map("registration_no") @db.VarChar(50)
  nikEnc         String          @map("nik_enc") @db.VarChar(255) // Enkripsi at-rest
  fullName       String          @map("full_name") @db.VarChar(200)
  birthDate      DateTime        @map("birth_date") @db.Date
  status         ApplicantStatus @default(draft)
  score          Decimal?        @db.Decimal(6, 2)
  rank           Int?
  decision       String?         @db.VarChar(50) // diterima | cadangan | ditolak
  stepData       Json?           @map("step_data") // Autosave formulir bertahap
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  wave             PPDBWave                 @relation(fields: [waveId], references: [id], onDelete: Restrict)
  track            PPDBTrack                @relation(fields: [trackId], references: [id], onDelete: Restrict)
  convertedStudent Student?                 @relation("ApplicantConvertedStudent", fields: [studentId], references: [id], onDelete: SetNull)
  parents          ApplicantParent[]
  documents        ApplicantDocument[]
  statusHistory    ApplicantStatusHistory[]
  reRegistration   PPDBReRegistration?

  @@index([waveId, status])
  @@index([trackId, rank])
  @@index([registrationNo])
  @@map("applicants")
}

model ApplicantParent {
  id          String   @id @default(uuid()) @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  parentType  String   @map("parent_type") @db.VarChar(30) // ayah | ibu | wali
  name        String   @db.VarChar(200)
  occupation  String?  @db.VarChar(100)
  incomeRange String?  @map("income_range") @db.VarChar(100)
  phone       String?  @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("applicant_parents")
}

model ApplicantDocument {
  id           String             @id @default(uuid()) @db.Uuid
  applicantId  String             @map("applicant_id") @db.Uuid
  fileId       String             @map("file_id") @db.Uuid
  documentType String             @map("document_type") @db.VarChar(100)
  status       VerificationStatus @default(menunggu)
  rejectReason String?            @map("reject_reason") @db.Text
  verifiedBy   String?            @map("verified_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  file      File      @relation("ApplicantDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)
  verifier  User?     @relation("PPDBDocVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@map("applicant_documents")
}

model ApplicantStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  fromStatus  String   @map("from_status") @db.VarChar(50)
  toStatus    String   @map("to_status") @db.VarChar(50)
  note        String?  @db.Text
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ApplicantStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@map("applicant_status_history")
}

model PPDBReRegistration {
  id          String    @id @default(uuid()) @db.Uuid
  applicantId String    @unique @map("applicant_id") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  status      String    @default("menunggu") @db.VarChar(50)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("ppdb_re_registrations")
}

// ==============================================================================
// 4. AKADEMIK I: JADWAL, JURNAL, PRESENSI, IZIN & LMS
// ==============================================================================

model TimeSlot {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  name      String   @db.VarChar(50) // Jam ke-1, Jam ke-2
  startTime String   @map("start_time") @db.VarChar(10) // HH:mm
  endTime   String   @map("end_time") @db.VarChar(10) // HH:mm
  dayType   String   @default("reguler") @map("day_type") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedules Schedule[]

  @@map("time_slots")
}

model Schedule {
  id         String   @id @default(uuid()) @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  classId    String   @map("class_id") @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  roomId     String?  @map("room_id") @db.Uuid
  timeSlotId String   @map("time_slot_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") // 1: Senin s.d. 7: Minggu
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  semester Semesters @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  class    Class     @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  timeSlot TimeSlot  @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)

  journals Journal[]

  @@unique([semesterId, classId, dayOfWeek, timeSlotId])
  @@index([teacherId, dayOfWeek, timeSlotId])
  @@index([roomId, dayOfWeek, timeSlotId])
  @@map("schedules")
}

model Journal {
  id          String   @id @default(uuid()) @db.Uuid
  scheduleId  String   @map("schedule_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  sessionDate DateTime @map("session_date") @db.Date
  topic       String   @db.VarChar(255)
  method      String   @db.VarChar(150)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  attendances Attendance[]

  @@index([scheduleId, sessionDate])
  @@map("journals")
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  journalId  String?          @map("journal_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  attDate    DateTime         @map("att_date") @db.Date
  status     AttendanceStatus @default(hadir)
  source     AttendanceSource @default(kelas)
  note       String?          @db.VarChar(255)
  recordedBy String?          @map("recorded_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  journal  Journal? @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recorder User?    @relation("AttendanceRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([journalId, studentId])
  @@index([studentId, attDate])
  @@index([journalId])
  @@map("attendances")
}

model LeaveRequest {
  id               String                @id @default(uuid()) @db.Uuid
  studentId        String                @map("student_id") @db.Uuid
  requestedBy      String?               @map("requested_by") @db.Uuid
  leaveType        LeaveType             @map("leave_type")
  startDate        DateTime              @map("start_date") @db.Date
  endDate          DateTime              @map("end_date") @db.Date
  reason           String                @db.Text
  attachmentFileId String?               @map("attachment_file_id") @db.Uuid
  status           RequestDecisionStatus @default(menunggu)
  decidedBy        String?               @map("decided_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachmentFile File?   @relation("LeaveRequestAttachmentFile", fields: [attachmentFileId], references: [id], onDelete: SetNull)
  decisionMaker  User?   @relation("LeaveRequestDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("leave_requests")
}

model StaffAttendance {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  attDate   DateTime              @map("att_date") @db.Date
  checkIn   DateTime?             @map("check_in") @db.Timestamptz(6)
  checkOut  DateTime?             @map("check_out") @db.Timestamptz(6)
  lat       Decimal?              @db.Decimal(10, 7)
  lng       Decimal?              @db.Decimal(10, 7)
  status    StaffAttendanceStatus @default(hadir)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attDate])
  @@map("staff_attendances")
}

model TeachingMaterial {
  id           String   @id @default(uuid()) @db.Uuid
  gradeLevelId String?  @map("grade_level_id") @db.Uuid
  subjectId    String?  @map("subject_id") @db.Uuid
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  fileId       String   @map("file_id") @db.Uuid
  materialType String   @map("material_type") @db.VarChar(50) // modul | ATP | silabus | P5
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploader   User        @relation("TeachingMaterialUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)
  file       File        @relation("TeachingMaterialFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@map("teaching_materials")
}

model LearningMaterial {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  title     String   @db.VarChar(200)
  fileId    String?  @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  file    File?   @relation("LearningMaterialFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@map("learning_materials")
}

model Assignment {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  title     String   @db.VarChar(200)
  dueAt     DateTime @map("due_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  class       Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject                  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher     Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  fileId       String?  @map("file_id") @db.Uuid
  score        Decimal? @db.Decimal(5, 2)
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file       File?      @relation("AssignmentSubmissionFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

// ==============================================================================
// 5. AKADEMIK II: NILAI, KARAKTER, E-PROGRESS REPORT & RAPOR
// ==============================================================================

model GradeComponent {
  id         String   @id @default(uuid()) @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  classId    String?  @map("class_id") @db.Uuid
  code       String   @db.VarChar(50) // UH, UTS, UAS, TUGAS
  name       String   @db.VarChar(100)
  weight     Decimal  @default(1.0) @db.Decimal(5, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  semester Semesters @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  class    Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)

  grades Grade[]

  @@unique([subjectId, semesterId, classId, code])
  @@map("grade_components")
}

model GradePeriod {
  id         String       @id @default(uuid()) @db.Uuid
  semesterId String       @map("semester_id") @db.Uuid
  month      Int          // 1-12
  status     PeriodStatus @default(open)
  lockedBy   String?      @map("locked_by") @db.Uuid
  lockedAt   DateTime?    @map("locked_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  semester Semesters @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  locker   User?     @relation("GradePeriodLockedBy", fields: [lockedBy], references: [id], onDelete: SetNull)

  grades          Grade[]
  characterNotes  CharacterNote[]
  progressReports ProgressReport[]

  @@unique([semesterId, month])
  @@map("grade_periods")
}

model Grade {
  id          String      @id @default(uuid()) @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  componentId String      @map("component_id") @db.Uuid
  periodId    String      @map("period_id") @db.Uuid
  examId      String?     @map("exam_id") @db.Uuid // Mengaitkan jika berasal dari CBT
  value       Decimal     @db.Decimal(5, 2) // 0 - 100
  source      GradeSource @default(manual)
  enteredBy   String?     @map("entered_by") @db.Uuid
  lockedAt    DateTime?   @map("locked_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  component GradeComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  period    GradePeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  exam      Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  enterer   User?          @relation("GradeEnteredBy", fields: [enteredBy], references: [id], onDelete: SetNull)

  @@unique([studentId, componentId, periodId])
  @@index([studentId, periodId])
  @@map("grades")
}

model CharacterNote {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  periodId      String   @map("period_id") @db.Uuid
  scaleData     Json     @map("scale_data") // Penilaian profil pelajar bulanan
  homeroomNote  String?  @map("homeroom_note") @db.Text
  authorId      String   @map("author_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period  GradePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([studentId, periodId])
  @@map("character_notes")
}

model ProgressReport {
  id           String               @id @default(uuid()) @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  periodId     String               @map("period_id") @db.Uuid
  dataSnapshot Json                 @map("data_snapshot") // Kunci snapshot saat disahkan
  fileId       String?              @map("file_id") @db.Uuid
  status       ProgressReportStatus @default(draft)
  approvedBy   String?              @map("approved_by") @db.Uuid
  verifyToken  String               @unique @map("verify_token") @db.VarChar(100) // Verifikasi QR publik
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period   GradePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  file     File?       @relation("ProgressReportFile", fields: [fileId], references: [id], onDelete: SetNull)
  approver User?       @relation("ProgressReportApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([studentId, periodId])
  @@index([verifyToken])
