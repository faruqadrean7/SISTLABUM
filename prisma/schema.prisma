model QuestionBank {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  gradeLevelId String?  @map("grade_level_id") @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  name         String   @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  questions  Question[]

  @@map("question_banks")
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  bankId         String         @map("bank_id") @db.Uuid
  questionType   QuestionType   @map("question_type")
  body           Json           // Konten soal rich text / formula / audio / gambar
  cpCode         String?        @map("cp_code") @db.VarChar(100)
  cognitiveLevel CognitiveLevel @default(MOTS) @map("cognitive_level")
  difficulty     Int            @default(3) // Skala 1 (sangat mudah) s.d. 5 (sangat sulit)
  weight         Decimal        @default(1.0) @db.Decimal(5, 2)
  explanation    String?        @db.Text
  version        Int            @default(1)
  status         ContentStatus  @default(draft)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  bank          QuestionBank       @relation(fields: [bankId], references: [id], onDelete: Cascade)
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  examAnswers   ExamAnswer[]
  itemAnalyses  ExamItemAnalysis[]

  @@index([bankId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String   @db.VarChar(10) // A, B, C, D, E
  body       Json     // Pilihan jawaban teks / gambar / formula
  isCorrect  Boolean  @default(false) @map("is_correct")
  matchKey   String?  @map("match_key") @db.VarChar(100) // Khusus soal menjodohkan
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Exam {
  id               String     @id @default(uuid()) @db.Uuid
  schoolId         String?    @map("school_id") @db.Uuid
  subjectId        String     @map("subject_id") @db.Uuid
  createdBy        String     @map("created_by") @db.Uuid
  parentExamId     String?    @map("parent_exam_id") @db.Uuid // Induk untuk ujian remedial
  title            String     @db.VarChar(200)
  examType         ExamType   @map("exam_type")
  durationMin      Int        @map("duration_min")
  startAt          DateTime   @map("start_at") @db.Timestamptz(6)
  endAt            DateTime   @map("end_at") @db.Timestamptz(6)
  passingGrade     Decimal    @default(75.0) @map("passing_grade") @db.Decimal(5, 2)
  shuffleQuestions Boolean    @default(true) @map("shuffle_questions")
  shuffleOptions   Boolean    @default(true) @map("shuffle_options")
  packageMode      String     @default("single") @map("package_mode") @db.VarChar(30)
  showResultMode   String     @default("after_release") @map("show_result_mode") @db.VarChar(30)
  status           ExamStatus @default(draft)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  creator        User               @relation("ExamCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  parentExam     Exam?              @relation("RemedialExamParent", fields: [parentExamId], references: [id], onDelete: SetNull)
  remedialExams  Exam[]             @relation("RemedialExamParent")
  examQuestions  ExamQuestion[]
  examRooms      ExamRoom[]
  participants   ExamParticipant[]
  sessions       ExamSession[]
  itemAnalyses   ExamItemAnalysis[]
  academicGrades Grade[]

  @@map("exams")
}

model ExamQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  examId         String   @map("exam_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  sortOrder      Int      @default(0) @map("sort_order")
  weightOverride Decimal? @map("weight_override") @db.Decimal(5, 2)
  packageCode    String?  @map("package_code") @db.VarChar(20) // A, B, dst.
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId, packageCode])
  @@map("exam_questions")
}

model ExamRoom {
  id             String    @id @default(uuid()) @db.Uuid
  examId         String    @map("exam_id") @db.Uuid
  roomId         String    @map("room_id") @db.Uuid
  proctorId      String?   @map("proctor_id") @db.Uuid
  sessionNo      Int       @default(1) @map("session_no")
  token          String    @db.VarChar(20)
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  room         Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  proctor      User?             @relation("ExamRoomProctor", fields: [proctorId], references: [id], onDelete: SetNull)
  participants ExamParticipant[]

  @@map("exam_rooms")
}

model ExamParticipant {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  examRoomId  String   @map("exam_room_id") @db.Uuid
  packageCode String?  @map("package_code") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@map("exam_participants")
}

model ExamSession {
  id           String            @id @default(uuid()) @db.Uuid
  examId       String            @map("exam_id") @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  status       ExamSessionStatus @default(belum)
  startedAt    DateTime?         @map("started_at") @db.Timestamptz(6)
  deadlineAt   DateTime?         @map("deadline_at") @db.Timestamptz(6) // Waktu server mutlak
  submittedAt  DateTime?         @map("submitted_at") @db.Timestamptz(6)
  extraMinutes Int               @default(0) @map("extra_minutes")
  seed         String            @db.VarChar(50) // Penjamin konsistensi acakan soal/opsi
  score        Decimal?          @db.Decimal(5, 2)
  lockedReason String?           @map("locked_reason") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam           Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  violations     ExamViolation[]
  proctorActions ExamProctorAction[]

  @@unique([examId, studentId])
  @@index([examId, status])
  @@map("exam_sessions")
}

model ExamAnswer {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  answer     Json?     // Nilai jawaban siswa
  isFlagged  Boolean   @default(false) @map("is_flagged") // Ragu-ragu
  score      Decimal?  @db.Decimal(5, 2)
  gradedBy   String?   @map("graded_by") @db.Uuid
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  session  ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  grader   User?       @relation("ExamAnswerGradedBy", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId])
  @@map("exam_answers")
}

model ExamViolation {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  violationType String   @map("violation_type") @db.VarChar(100) // blur, tab_switch, background
  meta          Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("exam_violations")
}

model ExamProctorAction {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(50) // reset, extra_time, force_submit, unlock
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor   User        @relation("ProctorActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("exam_proctor_actions")
}

model ExamItemAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  examId              String   @map("exam_id") @db.Uuid
  questionId          String   @map("question_id") @db.Uuid
  difficultyIndex     Decimal? @map("difficulty_index") @db.Decimal(5, 3)
  discriminationIndex Decimal? @map("discrimination_index") @db.Decimal(5, 3)
  distractorStats     Json?    @map("distractor_stats")
  calculatedAt        DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@map("exam_item_analysis")
}

