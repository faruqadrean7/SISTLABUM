# Bruno Environment Variables Example
# Copy this file to .env inside docs/api/bruno/SISTLABUM/ to run requests with authenticated tokens.
# Do NOT commit .env to git.

BRUNO_ADMIN_TOKEN=your-admin-sanctum-token
BRUNO_STUDENT_TOKEN=your-student-sanctum-token
BRUNO_PARENT_TOKEN=your-parent-sanctum-token
BRUNO_LOGOUT_TOKEN=your-disposable-logout-token
