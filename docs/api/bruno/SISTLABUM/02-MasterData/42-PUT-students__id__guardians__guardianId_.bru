meta {
  name: Guardian - Update Student Guardian
  type: http
  seq: 42
}

put {
  url: {{baseUrl}}/students/{id}/guardians/{guardianId}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{parentToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "status": "active",
    "notes": "Sample payload data"
  }
}

tests {
  test("status code is successful", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
}
