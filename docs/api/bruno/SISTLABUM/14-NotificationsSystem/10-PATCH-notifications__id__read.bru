meta {
  name: Notification - Mark As Read
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/notifications/{id}/read
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "status": "active",
    "notes": "Sample payload data"
  }
}

tests {
  test("status code is successful", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
}
