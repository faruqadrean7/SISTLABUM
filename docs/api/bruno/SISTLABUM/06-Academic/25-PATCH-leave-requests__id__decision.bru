  token: {{adminToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "status": "disetujui",
    "decision_notes": "Disetujui untuk peminjaman"
  }
}

tests {
  test("status code is successful", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
}
